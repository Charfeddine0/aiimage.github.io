<%- include('partials/header') %>
<h1>Your dashboard</h1>
<p><a class="button" href="/links/new">Create new link</a></p>
<table class="table">
  <thead>
    <tr>
      <th>Slug</th>
      <th>Destination</th>
      <th>Redirect</th>
      <th>Clicks</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (links.length === 0) { %>
      <tr><td colspan="6">No links yet.</td></tr>
    <% } %>
    <% links.forEach(link => { %>
      <tr>
        <td><a href="/<%= link.slug %>" target="_blank"><%= link.slug %></a></td>
        <td class="truncate"><%= link.longUrl %></td>
        <td><%= link.redirectType %></td>
        <td><%= link.clicks %></td>
        <td><%= link.enabled ? 'Enabled' : 'Disabled' %></td>
        <td>
          <a href="/links/<%= link.id %>/edit">Edit</a>
          <form method="POST" action="/links/<%= link.id %>/toggle" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button"><%= link.enabled ? 'Disable' : 'Enable' %></button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
<%- include('partials/footer') %>

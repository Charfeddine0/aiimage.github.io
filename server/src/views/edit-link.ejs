<%- include('partials/header') %>
<h1>Edit link</h1>
<% if (error) { %>
  <div class="alert"><%= error %></div>
<% } %>
<form method="POST" action="/links/<%= link.id %>" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p>Slug: <strong><%= link.slug %></strong></p>
  <label>Destination URL
    <input type="url" name="longUrl" value="<%= link.longUrl %>" required>
  </label>
  <label>Redirect type
    <select name="redirectType">
      <option value="301" <%= link.redirectType === 301 ? 'selected' : '' %>>301 (Permanent)</option>
      <option value="302" <%= link.redirectType === 302 ? 'selected' : '' %>>302 (Temporary)</option>
    </select>
  </label>
  <label>Expires at (optional)
    <input type="datetime-local" name="expiresAt" value="<%= link.expiresAt ? new Date(link.expiresAt).toISOString().slice(0,16) : '' %>">
  </label>
  <button type="submit" class="button">Save</button>
</form>
<%- include('partials/footer') %>
